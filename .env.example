# Chép file này thành .env rồi điền giá trị. File .env không được đưa lên git.

# Key SteamGridDB mặc định, dùng cho người dùng chưa nhập key riêng.
# Tạo key tại https://www.steamgriddb.com/profile/preferences/api
# (nên dùng tài khoản riêng cho app). Key được chèn vào bản build, chỉ main process đọc được.
MAIN_VITE_SGDB_KEY=
